# Uygulama sunucusu container runtime yapılandırması.
#
#   cp server/.env.example server/.env   ve düzenle
#
# podman'a --env-file olarak verilir: tırnak veya boşluk içermez.
# Parola taşır: 0600 izinle tutulur, Git'e girmez.

# Container veritabanına compose ağı üzerinden bağlanır; host portu container
# içinden erişilebilir değildir.
DATABASE_URL=postgresql://tefas:PAROLA@postgres:5432/tefas

# İlk admin kullanıcısının parolası. Verilmezse rastgele üretilip bir kez log'a
# yazılır ve ilk girişte değiştirilmesi istenir.
ADMIN_INITIAL_PASSWORD=

# Oturum süresi (saniye) ve TLS arkasındaysa çerezin Secure taşıması.
SESSION_TTL=43200
SECURE_COOKIE=false
