# Collector container runtime yapılandırması.
#
#   cp collector/.env.example collector/.env   ve düzenle
#
# Bu dosya podman'a --env-file olarak verilir: yalnız container'ın ihtiyacı olan
# değişkenler bulunur, tırnak veya boşluk içermez. Zamanlama ve ağ install-time
# kararıdır ve collector/install.sh seçenekleriyle verilir.
#
# Parola taşır: 0600 izinle tutulur, Git'e girmez, log'a ve komut satırına
# yazılmaz.

# Container veritabanına compose ağı üzerinden bağlanır. Host portu
# (127.0.0.1:5434) container içinden erişilebilir DEĞİLDİR; servis adı kullanılır.
DATABASE_URL=postgresql://tefas:PAROLA@postgres:5432/tefas
