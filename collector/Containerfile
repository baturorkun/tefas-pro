# Collector oneshot image.
#
# Sunucu imajı server/Containerfile ile kurulur; bu dosya yalnız collector'ı paketler.
# Collector'ın çalışma zamanı ihtiyacı farklıdır: Node, pg ve impit.
#
# Debian tabanlı, alpine değil: impit native bir modüldür ve prebuilt binary'si
# glibc'ye bağlıdır; musl tabanlı image'da yüklenmeyebilir.
FROM docker.io/library/node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsconfig.build.json ./
COPY scripts ./scripts
COPY src ./src
# Sürüm numarası. `pnpm build` RQ-0033'ten beri scripts/write-version.ts'i de
# çağırıyor; klasör kopyalanmayınca build hata veriyordu. Collector CI'da
# kurulmadığı için bu üç gün fark edilmedi ve sunucuda eski image çalışmaya
# devam etti — yeni kodun yazdığı alanlar boş kaldı.
#
# Değer sunucu imajındaki gibi dışarıdan verilir: requirements klasörü build
# context'ine girmiyor. Verilmezse yalnız ana sürüm görünür, build yine geçer.
ARG APP_REQUIREMENT=""
ENV APP_REQUIREMENT=$APP_REQUIREMENT
RUN pnpm build

FROM docker.io/library/node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

COPY --from=build /app/dist ./dist
# Migration ve takip listesi de gelir: aynı image ile şema kurulabilir ve liste
# beslenebilir (node dist/db/migrate.js, node dist/db/seed.js).
COPY db/migrations ./db/migrations
COPY db/watchlist.txt ./db/watchlist.txt

# Yazma ihtiyacı yok; ayrıcalıksız kullanıcıyla çalışır.
USER node

# Oneshot: toplar ve çıkar. Ayakta kalan bir servis yoktur, bu yüzden
# HEALTHCHECK de yoktur. Çıkış kodu run sonucunu taşır.
ENTRYPOINT ["node", "dist/collector.js"]
