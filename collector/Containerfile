# Collector oneshot image.
#
# Sunucu imajı server/Containerfile ile kurulur; bu dosya yalnız collector'ı paketler.
# Collector'ın çalışma zamanı ihtiyacı farklıdır: Node, pg ve impit.
#
# Debian tabanlı, alpine değil: impit native bir modüldür ve prebuilt binary'si
# glibc'ye bağlıdır; musl tabanlı image'da yüklenmeyebilir.
FROM docker.io/library/node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN pnpm build

FROM docker.io/library/node:22-bookworm-slim

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

COPY --from=build /app/dist ./dist
# Migration ve takip listesi de gelir: aynı image ile şema kurulabilir ve liste
# beslenebilir (node dist/db/migrate.js, node dist/db/seed.js).
COPY db/migrations ./db/migrations
COPY db/watchlist.txt ./db/watchlist.txt

# Yazma ihtiyacı yok; ayrıcalıksız kullanıcıyla çalışır.
USER node

# Oneshot: toplar ve çıkar. Ayakta kalan bir servis yoktur, bu yüzden
# HEALTHCHECK de yoktur. Çıkış kodu run sonucunu taşır.
ENTRYPOINT ["node", "dist/collector.js"]
